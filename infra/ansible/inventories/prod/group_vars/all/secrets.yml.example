---
# Template for secrets.yml. Create the real file with:
#   cp secrets.yml.example secrets.yml && ansible-vault encrypt secrets.yml
# Only the ENCRYPTED secrets.yml may be committed (CI rejects a plaintext one).
# Any credential left empty is simply not created in Jenkins.

jenkins_admin_password: "change-me"

# Username/password credentials
dockerhub_username: "tanmaysinghx"
dockerhub_token: ""          # Docker Hub access token  -> credential "dockerhub-creds"
github_username: "tanmaysinghx"
github_token: ""             # GitHub PAT (repo read)   -> credential "github-token"

# Secret text credentials
infra_vault_pwd: ""          # scripts/vault.js password -> credential "infra-vault-pwd"
oracle_db_password: ""       # -> credential "oracle-db-password"

# Secret file credentials (key = credential id from jenkins_file_credentials)
jenkins_secret_files:
  hidenseek-vpn-dev-env: |
    # full .env contents
  selfie-backend-dev-env: |
    # full .env contents
