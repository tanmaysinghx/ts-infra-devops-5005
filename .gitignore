# OS / editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Decrypted secrets — only .env.enc (vault-encrypted) and .env.example may be committed
.env
*.env
!*.env.example
.env.local
*.properties.dec
app.env

# Node
node_modules/

# Terraform — keep .terraform.lock.hcl and *.tfvars.example
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf

# Ansible — generated inventories, local binaries, plaintext vault files
infra/ansible/inventories/*/hosts.yml
infra/ansible/roles/hidenseek_agent/files/hidenseek-agent
*.retry
.vault-pass*
vault-pass*
.venv/
