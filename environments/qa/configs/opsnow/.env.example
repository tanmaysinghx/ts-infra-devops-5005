# OpsNow ITSM Platform - QA Environment Configuration
SERVER_PORT=8085

# Aiven Cloud MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://db1625-db1625.i.aivencloud.com:23308/defaultdb?sslMode=REQUIRED&useSSL=true&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=your_aiven_password_here

# Portal SSO Gateway Integration
OPSNOW_AUTH_SSO_PORTAL_URL=https://portal.tanmaysinghx.com/dashboard
OPSNOW_AUTH_SSO_SIGN_IN_URL=https://portal.tanmaysinghx.com/sign-in
OPSNOW_AUTH_SSO_ISSUER=https://portal.tanmaysinghx.com

# JVM Optimization
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
