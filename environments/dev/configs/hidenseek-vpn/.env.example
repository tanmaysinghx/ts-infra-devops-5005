# Hidenseek VPN backend - Development Environment Configuration
# Stored in Jenkins as the Secret file credential "hidenseek-vpn-dev-env"
# (or encrypt as .env.enc with scripts/vault.js).
PUBLIC_URL=https://vpn.tanmaysinghx.com

# MySQL 8 (tables are prefixed hs_)
DB_URL=jdbc:mysql://HOST:PORT/DATABASE?sslMode=REQUIRED
DB_USERNAME=
DB_PASSWORD=

# Portal SSO (confidential client "hidenseek-vpn")
PORTAL_URL=https://portal.tanmaysinghx.com
PORTAL_CLIENT_ID=hidenseek-vpn
PORTAL_CLIENT_SECRET=

ADMIN_EMAILS=tanmaysinghx@gmail.com
AUTO_APPROVE_USERS=false
ACTIVITY_RETENTION=30d
DB_POOL_SIZE=5
