# Eggless Observability - Development Environment Configuration
SERVER_PORT=8080
EGGLESS_HOME=/app/.eggless

# Database Configuration (Defaults to embedded persistent H2 if DB_URL is omitted)
# For external Postgres:
# DB_URL=jdbc:postgresql://postgres-dev:5432/eggless_dev
# DB_USERNAME=eggless
# DB_PASSWORD=eggless_dev_password

# Portal SSO Gateway Integration
PORTAL_BASE_URL=https://portal.tanmaysinghx.com
PORTAL_APP_ID=3fa85f64-5717-4562-b3fc-2c963f66afa6
PORTAL_APP_KEY=
PORTAL_CLIENT_ID=eggless-observability
PORTAL_REDIRECT_URI=http://localhost:8080/auth/callback

# JVM Optimization
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
