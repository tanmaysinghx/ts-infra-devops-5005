# selfie-backend (tanmaysinghx/selfie-portfolio/backend) runtime config.
# Real values live in the Jenkins "Secret file" credential selfie-backend-dev-env.
# HOST and PORT are set by the pipeline. Full reference: backend/README.md in selfie-portfolio.

DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/selfie?ssl-mode=required
# >= 32 chars; must equal BACKEND_API_KEY in the Vercel project
SERVICE_API_KEY=
# >= 32 chars; enables /api/v1/admin/*
ADMIN_TOKEN=
# >= 16 chars
VISITOR_HASH_SALT=
COMMENT_MODERATION=links
DB_MAX_CONNECTIONS=5
LOG_FORMAT=json
RUST_LOG=selfie_backend=info,tower_http=info,sqlx=warn
