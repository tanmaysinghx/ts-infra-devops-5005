# Portal SSO - Development Environment Configuration
ISSUER_URL=http://localhost:8090
SERVER_PORT=8090

# Database Configuration (Defaults to embedded H2 if DB_URL is omitted)
# For external Postgres:
# DB_URL=jdbc:postgresql://postgres-dev:5432/portalsso_dev
# DB_USERNAME=portal
# DB_PASSWORD=portal_dev_password

# Security & MFA Encryption Key (Base64-encoded 256-bit key)
# Generate via: openssl rand -base64 32
APP_SECURITY_MFA_ENCRYPTION_KEY=dGVzdC1tZmEtZW5jcnlwdGlvbi1rZXktZm9yLWRldi0xMjM=

# Bootstrap Administrator (Created on first run)
APP_BOOTSTRAP_ADMIN_EMAIL=admin@localhost
APP_BOOTSTRAP_ADMIN_PASSWORD=AdminDevPassword123!

# Cookie & Proxy Settings
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
FORWARD_HEADERS_STRATEGY=NONE
